<!-- Sugerencia de autofill (ADR 0011). Colores fijos, no del tema: la
     dibuja el sistema dentro de otra app y con el tema por defecto el
     texto quedaba oscuro sobre fondo oscuro en apps con tema oscuro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/autofill_suggestion_bg"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/autofill_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/autofill_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Rellenar con Lockspire"
        android:textColor="#FF0F2E2F"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
