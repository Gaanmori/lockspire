<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sync con la nube (WebDAV, Google Drive, OneDrive). Estaba solo en los
         manifiestos de debug y profile (plantilla de Flutter): el build
         release no podía sincronizar (revisión 2026-09-28). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- allowBackup="false" (revisión 2026-09-25, hallazgo S10): la bóveda
         (cifrada) y las preferencias no entran en la copia automática de
         Android. La copia de la bóveda es la sync, con cifrado propio; una
         restauración de Android dejaría el almacenamiento seguro (claves
         del Keystore, que no se copian) inconsistente con los datos. -->
    <application
        android:label="Lockspire"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>
        <!-- Ícono del lanzador según el tema (ADR 0031): un alias por tema y
             solo uno activo (LauncherIcon.kt). Lineage viene activo. -->
        <activity-alias
            android:name=".LauncherLineage"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherPixel"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pixel"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherUbuntu"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_ubuntu"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherMint"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_mint"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherWindows"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_windows"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Vuelta del login de OneDrive (ADR 0022): la abre el navegador con
             com.lockspire.lockspire://oauth2redirect. Sin interfaz; entrega
             la URI a Dart y trae la app al frente. -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.lockspire.lockspire" android:host="oauth2redirect" />
            </intent-filter>
        </activity>
        <!-- Autofill nativo (ADR 0011) — no exportada: solo puede
             lanzarla el PendingIntent que arma nuestro propio
             LockspireCredentialProviderService, nunca un intent externo
             directo de otra app. -->
        <activity
            android:name=".AutofillActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>

        <!-- Autofill nativo (ADR 0011) — servicio delgado, nunca lee ni
             desencripta la bóveda, ver docs/adr/0011-autofill-android-credential-provider.md -->
        <service
            android:name=".LockspireCredentialProviderService"
            android:enabled="true"
            android:exported="true"
            android:label="Lockspire"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider" />
        </service>

        <!-- Autofill legado (ADR 0011) — necesario junto con el
             servicio de arriba porque Credential Manager todavía no
             soporta campos dentro de un WebView (confirmado en
             verificación manual real, ver el ADR). Mismo criterio de
             servicio delgado. -->
        <service
            android:name=".LockspireAutofillService"
            android:enabled="true"
            android:exported="true"
            android:label="Lockspire"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_configuration" />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Íconos de las apps instaladas junto a sus entradas (ADR 0029):
             solo apps con ícono en el lanzador, sin QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!-- "Acerca de" abre el código fuente, la licencia y la política de
             privacidad en el navegador (url_launcher, Android 11+). -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
