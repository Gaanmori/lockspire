     Manifiesto del paquete MSIX para Microsoft Store (ADR 0028, 0035).
     tools/build_msix.ps1 reemplaza {IDENTITY}, {PUBLISHER},
     {PUBLISHER_DISPLAY_NAME} y {VERSION}.

     Sin virtualización de archivos ni de registro (desktop6 +
     unvirtualizedResources): la app escribe el token del canal IPC en
     %LOCALAPPDATA%\Lockspire\ipc y registra el native host en HKCU. Con la
     virtualización normal de MSIX, eso quedaría en una copia privada del
     paquete que Chrome y Edge no ven, y la extensión no podría conectarse
     (encontrado el 2026-09-30 con Claude, que es una app MSIX). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap uap3 desktop desktop4 desktop6">

  <Identity
    Name="{IDENTITY}"
    Publisher="{PUBLISHER}"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Lockspire</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-es" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Lockspire" Executable="lockspire.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Lockspire"
        Description="Gestor de contraseñas libre y local"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>

    <!-- El native host de la extensión (ADR 0013). Chrome y Edge no pueden
         ejecutar nada dentro de C:\Program Files\WindowsApps; el alias crea
         %LOCALAPPDATA%\Microsoft\WindowsApps\lockspire-native-host.exe, que
         sí pueden lanzar, con stdin/stdout (consola). Esa ruta además no
         cambia entre versiones, a diferencia de la carpeta del paquete. -->
    <Application
      Id="NativeHost"
      Executable="lockspire-native-host.exe"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:Subsystem="console"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Lockspire (native host)"
        Description="Canal entre la extensión del navegador y Lockspire"
        BackgroundColor="transparent"
        AppListEntry="none"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="lockspire-native-host.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="lockspire-native-host.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
