{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "action": {
    "default_title": "Lockspire",
    "default_popup": "popup.html",
    "default_icon": {
